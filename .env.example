# Application
APP_NAME=
APP_IMAGE=ghcr.io/your-org/your-app:v0.1.0
# Set to true when the database runs on the same server via docker-compose.db.yml
LOCAL_DB=false

# Server
NODE_ENV=development
PORT=5000

# Security
CORS_ORIGINS=
CORS_CREDENTIALS=true

# Database
# Single-server (LOCAL_DB=true): set to 'db' (compose service name)
# Separate-server: set to the remote hostname or IP
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Google OAuth (register credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend redirect target after successful login
CLIENT_REDIRECT_URL=http://localhost:3000
